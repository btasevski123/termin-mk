// Termin MK — futsal pitch booking (Resen)
// PostgreSQL + Prisma. Slot inventory is generated in app code
// (hourly 17:00–23:00); Booking rows are the occupied slots.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  ONLINE
  PHONE
}

enum BookingCancelReason {
  ADMIN
  EVENT
}

enum EventKind {
  HANDBALL
  THEATER
  TOURNAMENT
  OTHER
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Hall {
  id                  String    @id @default(cuid())
  name                String
  location            String
  slug                String    @unique
  timezone            String    @default("Europe/Skopje")
  /// First bookable hour (inclusive), e.g. 17 → 17:00
  slotStartHour       Int       @default(17)
  /// Hall closing hour (exclusive), e.g. 23 → last slot is 22:00–23:00
  slotEndHour         Int       @default(23)
  slotDurationMinutes Int       @default(60)
  bookings            Booking[]
  events              HallEvent[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

/// One reservation of a generated hourly slot.
/// Double-booking is blocked by `activeSlotKey` (unique). Cancelled rows
/// set it to null so PostgreSQL allows the same hall+date+startTime again.
model Booking {
  id                 String               @id @default(cuid())
  date               DateTime             @db.Date
  startTime          String
  endTime            String
  status             BookingStatus        @default(PENDING)
  source             BookingSource        @default(ONLINE)
  notes              String?
  cancelledAt        DateTime?
  cancelReason       BookingCancelReason?
  cancelledByEventId String?
  cancelledByEvent   HallEvent?           @relation(fields: [cancelledByEventId], references: [id], onDelete: SetNull)
  /// `${hallId}:${YYYY-MM-DD}:${startTime}` while PENDING/CONFIRMED; null when CANCELLED.
  activeSlotKey      String?              @unique
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  hallId             String
  hall               Hall                 @relation(fields: [hallId], references: [id], onDelete: Restrict)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([hallId, date])
  @@index([status])
  @@index([customerId])
  @@index([date, startTime])
  @@index([cancelledByEventId])
}

/// Occupies the hall so generated slots cannot be booked.
/// Null start/end time = every slot on each covered date.
model HallEvent {
  id                String    @id @default(cuid())
  title             String
  kind              EventKind @default(OTHER)
  /// Inclusive first date the hall is closed
  startDate         DateTime  @db.Date
  /// Inclusive last date (same as startDate for a single day)
  endDate           DateTime  @db.Date
  startTime         String?
  endTime           String?
  notes             String?
  hallId            String
  hall              Hall      @relation(fields: [hallId], references: [id], onDelete: Restrict)
  cancelledBookings Booking[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([hallId, startDate, endDate])
}
